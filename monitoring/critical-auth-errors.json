{
  "displayName": "Bite Lab critical authentication failures",
  "documentation": {
    "content": "One or more Bite Lab authentication Cloud Functions returned an internal error. Check Cloud Logging for auth_request_failed and auth_email_delivery_failed. Logs exclude passwords, reset tokens, email addresses, and IP addresses.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "Authentication function errors",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/bite_lab_auth_critical_errors\" AND resource.type=\"cloud_run_revision\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "300s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_SUM"
          }
        ],
        "trigger": { "count": 1 }
      }
    }
  ],
  "combiner": "OR",
  "enabled": true,
  "notificationChannels": [],
  "alertStrategy": {
    "autoClose": "1800s"
  }
}
